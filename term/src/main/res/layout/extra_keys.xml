<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/extra_keys_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161616"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <TableLayout
        android:id="@+id/extra_keys_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp">

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="36dp">

            <Button
                android:id="@+id/key_esc"
                style="@style/ExtraKeyButton"
                android:text="ESC" />
            <Button
                android:id="@+id/key_tab"
                style="@style/ExtraKeyButton"
                android:text="TAB" />
            <Button
                android:id="@+id/key_ctrl"
                style="@style/ExtraKeyButton"
                android:text="CTRL" />
            <Button
                android:id="@+id/key_alt"
                style="@style/ExtraKeyButton"
                android:text="ALT" />
            <Button
                android:id="@+id/key_minus"
                style="@style/ExtraKeyButton"
                android:text="-" />
            <Button
                android:id="@+id/key_underscore"
                style="@style/ExtraKeyButton"
                android:text="_" />
            <Button
                android:id="@+id/key_home"
                style="@style/ExtraKeyButton"
                android:text="HOME" />
            <Button
                android:id="@+id/key_up"
                style="@style/ExtraKeyButton"
                android:text="↑" />
            <Button
                android:id="@+id/key_end"
                style="@style/ExtraKeyButton"
                android:text="END" />
        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/key_keyboard"
                style="@style/ExtraKeyButton"
                android:text="KEY" />
            <Button
                android:id="@+id/key_tilde"
                style="@style/ExtraKeyButton"
                android:text="~" />
            <Button
                android:id="@+id/key_slash"
                style="@style/ExtraKeyButton"
                android:text="/" />
            <Button
                android:id="@+id/key_pipe"
                style="@style/ExtraKeyButton"
                android:text="|" />
            <Button
                android:id="@+id/key_pgup"
                style="@style/ExtraKeyButton"
                android:text="PGUP" />
            <Button
                android:id="@+id/key_pgdn"
                style="@style/ExtraKeyButton"
                android:text="PGDN" />
            <Button
                android:id="@+id/key_left"
                style="@style/ExtraKeyButton"
                android:text="←" />
            <Button
                android:id="@+id/key_down"
                style="@style/ExtraKeyButton"
                android:text="↓" />
            <Button
                android:id="@+id/key_right"
                style="@style/ExtraKeyButton"
                android:text="→" />
        </TableRow>

    </TableLayout>
</HorizontalScrollView>
